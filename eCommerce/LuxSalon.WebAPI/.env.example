# Kopiraj ovaj fajl u ".env" i popuni stvarnim vrijednostima. ".env" se NE komituje u git.
ConnectionStrings__DefaultConnection="Server=localhost,1435;Database=190067;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;"
JwtToken__SecretKey=YOUR_LONG_RANDOM_JWT_SECRET
RabbitMQ__UserName=guest
RabbitMQ__Password=guest
PayPal__ClientId=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PayPal__ClientSecret=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
# Comma-separated lista dozvoljenih origina za CORS (koristi ih samo Flutter web build).
# Ako se ne postavi, koristi se default lista uobicajenih localhost portova (vidi Program.cs).
AllowedOrigins=http://localhost:5000,http://localhost:3000,http://localhost:8080
